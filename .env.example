# ----------------------------------------------------------------------------
# PopsShop environment variables
# Copy to ".env.local" for local dev, and set the same in Vercel for production.
# All of these are SERVER-ONLY secrets — none are prefixed with NEXT_PUBLIC.
# ----------------------------------------------------------------------------

# --- Supabase (the DEDICATED PopsShop project — NOT Ten-Eight/FleetManage) ---
# Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings → API → service_role key (secret! bypasses RLS — server only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin console (REQUIRED — no hardcoded fallback; login fails closed) ---
# Strong random value, >= 24 chars. Used to sign the admin session JWT.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=replace-with-strong-random-48-byte-value
# Primary admin login. Use a strong, unique password — this guards /admin.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-strong-password
# Additional accounts — increment the number for each extra user
# ADMIN_USERNAME_2=
# ADMIN_PASSWORD_2=

# --- Square (payments) ---
# Square Developer Dashboard → Application → Credentials
# Use "production" or "sandbox"
SQUARE_ENV=production
# Production or Sandbox Access Token
SQUARE_ACCESS_TOKEN=EAAAlxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Main location ID (Locations tab in Square Dashboard)
SQUARE_LOCATION_ID=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhooks → your endpoint → Signature key
SQUARE_WEBHOOK_SIGNATURE_KEY=your-webhook-signature-key
# Client-side (these are safe to expose — they are public values)
NEXT_PUBLIC_SQUARE_ENV=production
NEXT_PUBLIC_SQUARE_APP_ID=sq0idp-xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SQUARE_LOCATION_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Twilio (SMS notifications to the shop) ---
# Twilio Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# A Twilio phone number you own, in E.164 format
TWILIO_FROM_NUMBER=+15551234567
# Where order-request texts are delivered — the shop owner's mobile, E.164 format
BUSINESS_PHONE=+15557654321
