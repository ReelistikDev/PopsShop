# ----------------------------------------------------------------------------
# PopsShop environment variables
# Copy to ".env.local" for local dev, and set the same in Vercel for production.
# Most are SERVER-ONLY secrets. The NEXT_PUBLIC_ vars (Square app/location) are
# intentionally shipped to the browser — that is required by the Web Payments SDK.
# ----------------------------------------------------------------------------

# --- Supabase (the DEDICATED PopsShop project — NOT Ten-Eight/FleetManage) ---
# Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings → API → service_role key (secret! bypasses RLS — server only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Twilio (SMS notifications to the shop) ---
# Twilio Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# A Twilio phone number you own, in E.164 format
TWILIO_FROM_NUMBER=+15551234567
# Where order-request texts are delivered — the shop owner's mobile, E.164 format
BUSINESS_PHONE=+15557654321

# --- Square (online "Buy Now" checkout via the Web Payments SDK) ---
# Developer Dashboard → your app → Credentials. Use SANDBOX values for testing,
# PRODUCTION values when going live. Keep sandbox/production sets in sync with SQUARE_ENV.
#
# SERVER-ONLY (secret) — used to actually charge the card:
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_LOCATION_ID=your-square-location-id
# "sandbox" (default) or "production":
SQUARE_ENV=sandbox
#
# PUBLIC (safe to expose) — used by the browser to render the card form.
# These MUST mirror the access token's environment (sandbox app id with sandbox token).
NEXT_PUBLIC_SQUARE_APP_ID=your-square-application-id
NEXT_PUBLIC_SQUARE_LOCATION_ID=your-square-location-id
NEXT_PUBLIC_SQUARE_ENV=sandbox
